# Optional Solana RPC endpoint (Helius, QuickNode, or public RPC).
# Global override for the active Solana network when Settings has no per-network override.
# Prefer leaving unset so Settings → Network uses the managed Mainnet/Devnet defaults.
# TAURVIA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Managed Solana defaults when unset (chosen by Settings → Network):
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet:  https://api.devnet.solana.com

# Optional Ethereum JSON-RPC (Ethereum mainnet/Sepolia only — never Base, BNB, or Polygon).
# Prefer Settings → Advanced per-network rpc_urls for non-Ethereum EVM.
# TAURVIA_ETH_RPC_URL=

# BNB Chain RPC is per-network (Settings → Advanced, key bnb-mainnet).
# Default: https://bsc-rpc.publicnode.com
# Chapel testnet: https://bsc-testnet-rpc.publicnode.com

# Polygon RPC is per-network (Settings → Advanced, key polygon-mainnet).
# Default: https://polygon-bor-rpc.publicnode.com
# Amoy testnet: https://polygon-amoy-bor-rpc.publicnode.com

# Base RPC is per-network (Settings → Advanced, key base-mainnet).
# Default: https://base-rpc.publicnode.com
# Base Sepolia: https://base-sepolia-rpc.publicnode.com

# Optional Bitcoin Esplora base URL (no trailing path beyond the API root).
# TAURVIA_BTC_ESPLORA_URL=

# Optional Sui JSON-RPC (Mainnet or Testnet, whichever is active).
# Mysten public fullnodes no longer serve JSON-RPC; default is PublicNode.
# TAURVIA_SUI_RPC_URL=https://sui-rpc.publicnode.com

# Optional Jupiter API key (free tier at https://portal.jup.ag)
# Keyless requests work by default; set this for higher rate limits.
# TAURVIA_JUPITER_API_KEY=

# Optional 0x API key for Ethereum swaps (also Settings → Advanced).
# TAURVIA_0X_API_KEY=
